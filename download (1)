from __future__ import annotations

import logging
import time
from collections.abc import Iterable
from datetime import datetime
from typing import Any

import requests
from requests.adapters import HTTPAdapter
from urllib3.util.retry import Retry

from app.config import Settings


LOGGER = logging.getLogger(__name__)


class AlpacaClient:
    def __init__(self, settings: Settings) -> None:
        self.settings = settings
        self.session = requests.Session()
        retry = Retry(
            total=6,
            connect=4,
            read=4,
            status=6,
            backoff_factor=1.0,
            status_forcelist=(429, 500, 502, 503, 504),
            allowed_methods=frozenset({"GET"}),
            respect_retry_after_header=True,
        )
        self.session.mount("https://", HTTPAdapter(max_retries=retry))
        self.session.headers.update(
            {
                "APCA-API-KEY-ID": settings.alpaca_api_key,
                "APCA-API-SECRET-KEY": settings.alpaca_secret_key,
                "Accept": "application/json",
                "User-Agent": "alpaca-sheets-screener/1.0",
            }
        )

    def _get(self, url: str, params: dict[str, Any] | None = None) -> Any:
        response = self.session.get(
            url,
            params=params,
            timeout=self.settings.request_timeout_seconds,
        )
        response.raise_for_status()
        if self.settings.request_pause_seconds:
            time.sleep(self.settings.request_pause_seconds)
        return response.json()


    def get_market_clock(self) -> dict[str, Any]:
        """Return Alpaca's U.S. equity market clock.

        The clock accounts for weekends, exchange holidays, early closes, and
        daylight-saving time, so it is safer than encoding market hours in UTC.
        """
        payload = self._get(f"{self.settings.alpaca_trading_base_url}/v2/clock")
        if not isinstance(payload, dict):
            raise ValueError("Unexpected response from Alpaca market clock")
        return payload

    def get_tradable_assets(self) -> list[dict[str, Any]]:
        payload = self._get(
            f"{self.settings.alpaca_trading_base_url}/v2/assets",
            params={"status": "active", "asset_class": "us_equity"},
        )
        assets = [
            asset
            for asset in payload
            if asset.get("tradable") is True
            and asset.get("status") == "active"
            and asset.get("class") == "us_equity"
        ]
        assets.sort(key=lambda item: item.get("symbol", ""))
        LOGGER.info("Found %s active tradable U.S. equity assets", len(assets))
        return assets

    def get_snapshots(self, symbols: list[str]) -> dict[str, dict[str, Any]]:
        if not symbols:
            return {}
        payload = self._get(
            f"{self.settings.alpaca_data_base_url}/v2/stocks/snapshots",
            params={
                "symbols": ",".join(symbols),
                "feed": self.settings.alpaca_data_feed,
            },
        )
        if isinstance(payload, dict) and "snapshots" in payload:
            return payload["snapshots"]
        return payload if isinstance(payload, dict) else {}

    def get_daily_bars(
        self,
        symbols: list[str],
        start: datetime,
        end: datetime,
    ) -> dict[str, list[dict[str, Any]]]:
        bars_by_symbol: dict[str, list[dict[str, Any]]] = {symbol: [] for symbol in symbols}
        page_token: str | None = None

        while True:
            params: dict[str, Any] = {
                "symbols": ",".join(symbols),
                "timeframe": "1Day",
                "start": start.isoformat(),
                "end": end.isoformat(),
                "adjustment": "all",
                "feed": self.settings.alpaca_data_feed,
                "limit": 10000,
                "sort": "asc",
            }
            if page_token:
                params["page_token"] = page_token

            payload = self._get(
                f"{self.settings.alpaca_data_base_url}/v2/stocks/bars",
                params=params,
            )
            for symbol, rows in payload.get("bars", {}).items():
                bars_by_symbol.setdefault(symbol, []).extend(rows)

            page_token = payload.get("next_page_token")
            if not page_token:
                break

        return bars_by_symbol


def chunks(items: list[str], size: int) -> Iterable[list[str]]:
    for index in range(0, len(items), size):
        yield items[index : index + size]
